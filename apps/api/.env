# Database PostgreSQL (AWS RDS production / localhost development)
DATABASE_URL="postgresql://postgres:admin123@localhost:5432/ppwl_facebook_clone"

# JWT secret - ganti dengan string acak panjang di production
JWT_SECRET="dev-secret-change-in-production"

# Origin frontend (CORS)
WEB_ORIGIN="http://localhost:5173"

# Admin secret key untuk endpoint /users?key=...
ADMIN_SECRET_KEY="your-admin-secret-key"

# Google OAuth Client ID (sama dengan yang di frontend)
# Diperlukan untuk validasi aud claim saat verifikasi token Google
GOOGLE_CLIENT_ID="your-google-client-id-here.apps.googleusercontent.com"
