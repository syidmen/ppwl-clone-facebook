{
  "name": "@ppwl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma": "prisma",
    "build:lambda": "bun build src/lambda.ts --outdir dist-lambda --target node --format cjs --external @prisma/client --external prisma",
    "package:lambda": "bun run build:lambda && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-lambda.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-ssm": "^3.1049.0",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@ppwl/shared": "workspace:*",
    "@prisma/client": "^6.7.0",
    "bcryptjs": "^3.0.3",
    "elysia": "^1.2.25",
    "google-auth-library": "^10.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/bun": "^1.2.13",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  }
}
