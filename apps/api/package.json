{
  "name": "@ppwl/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prisma": "prisma"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.2.0",
    "@elysiajs/jwt": "^1.2.0",
    "@elysiajs/swagger": "^1.2.0",
    "@prisma/client": "^6.7.0",
    "@ppwl/shared": "workspace:*",
    "bcryptjs": "^3.0.2",
    "elysia": "^1.2.25"
  },
  "devDependencies": {
    "@types/bun": "^1.2.13",
    "prisma": "^6.7.0",
    "typescript": "^5.8.3"
  }
}
